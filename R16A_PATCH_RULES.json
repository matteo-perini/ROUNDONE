    "after": "  <header class=\"panel lf19c-header lfcc-main-header\"><div><p class=\"lfcc-main-eyebrow\">LIONFIT · PLATFORM OWNER</p><h1>Control Center <span>3.0</span></h1><p class=\"muted\">La tua centrale operativa SaaS · dati reali, controlli sicuri, visibilità sui servizi.</p></div><button v-if=\"independent\" type=\"button\" class=\"secondary\" @click=\"leave\">Esci dal Control Center</button><RouterLink v-else to=\"/impostazioni\" class=\"secondary\">Torna alle impostazioni</RouterLink></header>\n  <nav v-lf-motion-tabs class=\"lf19c-tabs lfcc-navigation\" aria-label=\"Sezioni Control Center\"><button v-for=\"item in controlTabs\" :key=\"item.id\" type=\"button\" :class=\"tab===item.id?'primary':'secondary'\" :aria-pressed=\"tab===item.id\" :disabled=\"busy\" @click=\"switchTab(item.id)\">{{item.label}}<span v-if=\"item.id==='tickets'&&unreadTickets\" class=\"lf29-tab-count\">{{unreadTickets}}</span></button><button v-if=\"billingSandboxEnabled()\" type=\"button\" :class=\"tab==='billing'?'primary':'secondary'\" :aria-pressed=\"tab==='billing'\" :disabled=\"busy\" @click=\"switchTab('billing')\">Sandbox Stripe</button></nav>"
